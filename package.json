{
  "name": "mist-continent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "play": "pnpm build && tsx server/index.ts --play",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src server scripts tests vite.config.ts package.json tsconfig*.json",
    "server": "tsx --env-file-if-exists=.env server/index.ts",
    "server:dev": "tsx watch --env-file-if-exists=.env server/index.ts",
    "server:backup": "tsx --env-file-if-exists=.env server/backup.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.7",
    "lucide-react": "^0.468.0",
    "pixi.js": "^8.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "terser": "^5.51.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
