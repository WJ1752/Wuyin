# Local development: the frontend runs on http://127.0.0.1:5173.
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=data/wuyin.sqlite
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
NODE_ENV=development
TRUST_PROXY=0
# Only for an explicitly chosen unencrypted public HTTP test. Keep disabled for normal production.
ALLOW_INSECURE_PUBLIC_TEST=0
MAX_OFFICIAL_TRIALS=4
MAX_HOSTED_ROOMS=2
# Optional: a random secret of at least 32 characters for the private operations metrics endpoint.
# OPERATIONS_TOKEN=

# Docker Compose overrides the above server values for same-origin HTTPS.
# Use a real domain without a scheme, path, or port. Point its DNS to the server.
PUBLIC_DOMAIN=game.example.com
ACME_EMAIL=ops@example.com
